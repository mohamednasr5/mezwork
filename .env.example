# ========================================
# MezoMenu - Environment Variables
# Copy this file to .env and fill in your values
# ========================================

# ----------------------------------------
# Firebase Configuration
# ----------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ----------------------------------------
# NVIDIA AI API
# Get your API key from: https://build.nvidia.com/
# ----------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here

# ----------------------------------------
# Cloudflare R2 Storage
# Configure in Cloudflare Dashboard > R2
# ----------------------------------------
R2_BUCKET_NAME=mezomenu-images
R2_PUBLIC_URL=https://images.mezomenu.com

# ----------------------------------------
# WhatsApp Business API
# Optional - For sending orders via WhatsApp
# ----------------------------------------
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/your_phone_number_id/messages
WHATSAPP_API_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ----------------------------------------
# Application Settings
# ----------------------------------------
APP_NAME=MezoMenu
APP_URL=https://mezomenu.com
API_URL=https://api.mezomenu.com
ENVIRONMENT=development

# ----------------------------------------
# JWT Secret (for token generation)
# Generate with: openssl rand -base64 32
# ----------------------------------------
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ----------------------------------------
# Email Service (Optional)
# For password reset and notifications
# ----------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@mezomenu.com

# ----------------------------------------
# Rate Limiting
# ----------------------------------------
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ----------------------------------------
# Feature Flags
# ----------------------------------------
ENABLE_AI_ANALYSIS=true
ENABLE_IMAGE_GENERATION=true
ENABLE_WHATSAPP_INTEGRATION=true
ENABLE_PUSH_NOTIFICATIONS=true
